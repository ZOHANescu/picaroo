{
  "name": "picaroo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A local, source-aware image editor for development.",
  "bin": {
    "picaroo": "./bin/picaroo.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./vite.mjs"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx/esm --test src/assets/optimize.test.ts src/source-edits/angular.test.ts src/source-edits/html.test.ts src/source-edits/react.test.ts src/integrations/project.test.ts src/integrations/components.test.ts",
    "test:e2e:html": "node test/run-e2e.mjs html",
    "test:e2e:react": "node test/run-e2e.mjs react",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "magic-string": "^0.30.17",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "svgo": "^4.0.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cypress": "^16.1.1",
    "typescript": "~5.9.2"
  }
}
